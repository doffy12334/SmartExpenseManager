<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/dashboard_hero"
    android:padding="20dp"
    android:elevation="6dp"
    android:layout_marginTop="12dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/dashboard_hero_pill"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">
            <ImageView
                android:layout_width="13dp"
                android:layout_height="11dp"
                android:src="@drawable/dashboard_bank"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />
            <View
                android:layout_width="6dp"
                android:layout_height="1dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_account"
                android:textSize="11sp"
                android:textColor="@color/dashboard_white"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/dashboard_hero_pill"
            android:id="@+id/dashboard_balance_visibility"
            android:contentDescription="@string/dashboard_balance_visibility_action"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="17dp"
                android:layout_height="11dp"
                android:src="@drawable/dashboard_eye"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>
    <View
        android:layout_width="1dp"
        android:layout_height="16dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dashboard_balance_label"
        android:textSize="11sp"
        android:textColor="@color/dashboard_mint"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.08" />
    <View
        android:layout_width="1dp"
        android:layout_height="2dp" />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/dashboard_balance"
        android:textSize="30sp"
        android:textColor="@color/dashboard_white"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium"
        android:id="@+id/dashboard_balance"
        android:maxLines="1"
        android:ellipsize="end" />
    <View
        android:layout_width="1dp"
        android:layout_height="22dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:layout_weight="1"
            android:background="@drawable/dashboard_hero_tile"
            android:gravity="center_vertical"
            android:padding="8dp">
            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/dashboard_hero_tile">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/dashboard_income"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no"
                    android:layout_gravity="center" />
            </FrameLayout>
            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_income"
                    android:textSize="11sp"
                    android:textColor="@color/dashboard_mint"
                    android:includeFontPadding="false" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_income_value"
                    android:textSize="12sp"
                    android:textColor="@color/dashboard_white"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
        <View
            android:layout_width="10dp"
            android:layout_height="1dp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:orientation="horizontal"
            android:layout_weight="1"
            android:background="@drawable/dashboard_hero_tile"
            android:gravity="center_vertical"
            android:padding="8dp">
            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/dashboard_hero_tile">
                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:src="@drawable/dashboard_expense"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no"
                    android:layout_gravity="center" />
            </FrameLayout>
            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_weight="1">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_expense"
                    android:textSize="11sp"
                    android:textColor="@color/dashboard_mint"
                    android:includeFontPadding="false" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_expense_value"
                    android:textSize="12sp"
                    android:textColor="@color/dashboard_white"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <View
        android:layout_width="1dp"
        android:layout_height="18dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_weight="1"
            android:background="@drawable/dashboard_white_tile"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:id="@+id/dashboard_transfer"
            android:contentDescription="@string/dashboard_transfer_action"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="15dp"
                android:layout_height="12dp"
                android:src="@drawable/dashboard_transfer"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />
            <View
                android:layout_width="6dp"
                android:layout_height="1dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_transfer"
                android:textSize="12sp"
                android:textColor="@color/dashboard_accent"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="2" />
        </LinearLayout>
        <View
            android:layout_width="8dp"
            android:layout_height="1dp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_weight="1"
            android:background="@drawable/dashboard_hero_tile"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:id="@+id/dashboard_top_up"
            android:contentDescription="@string/dashboard_top_up_action"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="15dp"
                android:layout_height="12dp"
                android:src="@drawable/dashboard_top_up"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />
            <View
                android:layout_width="6dp"
                android:layout_height="1dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_top_up"
                android:textSize="12sp"
                android:textColor="@color/dashboard_white"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="2" />
        </LinearLayout>
        <View
            android:layout_width="8dp"
            android:layout_height="1dp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_weight="1"
            android:background="@drawable/dashboard_hero_tile"
            android:gravity="center"
            android:paddingHorizontal="4dp"
            android:id="@+id/dashboard_report"
            android:contentDescription="@string/dashboard_report_action"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <ImageView
                android:layout_width="15dp"
                android:layout_height="12dp"
                android:src="@drawable/dashboard_report"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />
            <View
                android:layout_width="6dp"
                android:layout_height="1dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_report"
                android:textSize="12sp"
                android:textColor="@color/dashboard_white"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="2" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
