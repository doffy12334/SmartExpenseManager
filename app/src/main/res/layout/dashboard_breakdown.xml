<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/dashboard_card"
    android:elevation="1dp"
    android:layout_marginTop="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_breakdown"
                android:textSize="16sp"
                android:textColor="@color/dashboard_ink"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_breakdown_month"
                android:textSize="12sp"
                android:textColor="@color/dashboard_secondary"
                android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/dashboard_blue_pill"
            android:gravity="center_vertical"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_categories"
                android:textSize="11sp"
                android:textColor="@color/dashboard_secondary"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
    <View
        android:layout_width="1dp"
        android:layout_height="12dp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <FrameLayout
            android:layout_width="144dp"
            android:layout_height="144dp">
            <FrameLayout
                android:layout_width="144dp"
                android:layout_height="144dp"
                android:rotation="-90">
                <ImageView
                    android:layout_width="132dp"
                    android:layout_height="132dp"
                    android:src="@drawable/dashboard_donut_track"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="6dp" />
                <ImageView
                    android:layout_width="43.6235dp"
                    android:layout_height="65.4887dp"
                    android:src="@drawable/dashboard_donut_blue"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="94.3765dp"
                    android:layout_marginTop="63.6dp" />
                <ImageView
                    android:layout_width="78.5193dp"
                    android:layout_height="27.2039dp"
                    android:src="@drawable/dashboard_donut_orange"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="30.585dp"
                    android:layout_marginTop="110.7961dp" />
                <ImageView
                    android:layout_width="39.4504dp"
                    android:layout_height="94.7161dp"
                    android:src="@drawable/dashboard_donut_green"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="6dp"
                    android:layout_marginTop="31.484dp" />
                <ImageView
                    android:layout_width="120.827dp"
                    android:layout_height="74.4049dp"
                    android:src="@drawable/dashboard_donut_red"
                    android:scaleType="fitXY"
                    android:importantForAccessibility="no"
                    android:layout_marginStart="17.173dp"
                    android:layout_marginTop="6dp" />
            </FrameLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_gravity="center"
                android:gravity="center">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_donut_total"
                    android:textSize="11sp"
                    android:textColor="@color/dashboard_secondary"
                    android:includeFontPadding="false" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_donut_amount"
                    android:textSize="13sp"
                    android:textColor="@color/dashboard_ink"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_currency"
                    android:textSize="10sp"
                    android:textColor="@color/dashboard_accent"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium"
                    tools:ignore="SmallSp" />
            </LinearLayout>
        </FrameLayout>
        <View
            android:layout_width="12dp"
            android:layout_height="1dp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="24dp">
                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dashboard_food_dot" />
                <View
                    android:layout_width="6dp"
                    android:layout_height="1dp" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_food"
                    android:textSize="12sp"
                    android:textColor="@color/dashboard_ink"
                    android:includeFontPadding="false"
                    android:layout_weight="1" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_food_percent"
                    android:textSize="12sp"
                    android:textColor="@color/dashboard_ink"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="24dp">
                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dashboard_shopping_dot" />
                <View
                    android:layout_width="6dp"
                    android:layout_height="1dp" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_shopping"
                    android:textSize="12sp"
                    android:textColor="@color/dashboard_ink"
                    android:includeFontPadding="false"
                    android:layout_weight="1" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_shopping_percent"
                    android:textSize="12sp"
                    android:textColor="@color/dashboard_ink"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="24dp">
                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dashboard_bills_dot" />
                <View
                    android:layout_width="6dp"
                    android:layout_height="1dp" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_bills"
                    android:textSize="12sp"
                    android:textColor="@color/dashboard_ink"
                    android:includeFontPadding="false"
                    android:layout_weight="1" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_bills_percent"
                    android:textSize="12sp"
                    android:textColor="@color/dashboard_ink"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="24dp">
                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/dashboard_travel_dot" />
                <View
                    android:layout_width="6dp"
                    android:layout_height="1dp" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_travel"
                    android:textSize="12sp"
                    android:textColor="@color/dashboard_ink"
                    android:includeFontPadding="false"
                    android:layout_weight="1" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_travel_percent"
                    android:textSize="12sp"
                    android:textColor="@color/dashboard_ink"
                    android:includeFontPadding="false"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
