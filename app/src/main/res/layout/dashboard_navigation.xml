<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="92dp"
    android:layout_gravity="bottom">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="bottom"
        android:background="@color/finora_background"
        android:elevation="2dp">
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:orientation="vertical"
            android:layout_weight="1"
            android:gravity="center"
            android:id="@+id/dashboard_nav_home"
            android:contentDescription="@string/dashboard_nav_home_action"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="26dp"
                android:background="@drawable/dashboard_mint_pill">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/dashboard_home"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no"
                    android:layout_gravity="center" />
            </FrameLayout>
            <View
                android:layout_width="1dp"
                android:layout_height="3dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_nav_home"
                android:textSize="11sp"
                android:textColor="@color/finora_emerald"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:orientation="vertical"
            android:layout_weight="1"
            android:gravity="center"
            android:id="@+id/dashboard_nav_transactions"
            android:contentDescription="@string/dashboard_nav_transactions_action"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="26dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/dashboard_transactions"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no"
                    android:layout_gravity="center" />
            </FrameLayout>
            <View
                android:layout_width="1dp"
                android:layout_height="3dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_nav_transactions"
                android:textSize="11sp"
                android:textColor="@color/finora_ink"
                android:includeFontPadding="false" />
        </LinearLayout>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:orientation="vertical"
            android:layout_weight="1"
            android:gravity="center"
            android:id="@+id/dashboard_nav_budget"
            android:contentDescription="@string/dashboard_nav_budget_action"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="26dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/dashboard_budget"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no"
                    android:layout_gravity="center" />
            </FrameLayout>
            <View
                android:layout_width="1dp"
                android:layout_height="3dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_nav_budget"
                android:textSize="11sp"
                android:textColor="@color/finora_ink"
                android:includeFontPadding="false" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:orientation="vertical"
            android:layout_weight="1"
            android:gravity="center"
            android:id="@+id/dashboard_nav_settings"
            android:contentDescription="@string/dashboard_nav_settings_action"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <FrameLayout
                android:layout_width="50dp"
                android:layout_height="26dp">
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/dashboard_settings"
                    android:scaleType="fitCenter"
                    android:importantForAccessibility="no"
                    android:layout_gravity="center" />
            </FrameLayout>
            <View
                android:layout_width="1dp"
                android:layout_height="3dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_nav_settings"
                android:textSize="11sp"
                android:textColor="@color/finora_ink"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/dashboard_add_circle"
        android:elevation="6dp"
        android:id="@+id/dashboard_add"
        android:contentDescription="@string/dashboard_add_action"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground">
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:src="@drawable/dashboard_add"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:layout_gravity="center" />
    </FrameLayout>
</FrameLayout>
