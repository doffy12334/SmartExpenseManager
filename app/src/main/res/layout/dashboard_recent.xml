<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="6dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/dashboard_recent"
            android:textSize="18sp"
            android:textColor="@color/finora_ink"
            android:includeFontPadding="false"
            android:fontFamily="sans-serif-medium"
            android:layout_weight="1" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center"
            android:id="@+id/dashboard_see_all"
            android:contentDescription="@string/dashboard_see_all_action"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_see_all"
                android:textSize="12sp"
                android:textColor="@color/finora_emerald"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium" />
            <View
                android:layout_width="4dp"
                android:layout_height="1dp" />
            <ImageView
                android:layout_width="5dp"
                android:layout_height="8dp"
                android:src="@drawable/dashboard_chevron"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/dashboard_card"
        android:elevation="1dp"
        android:padding="12dp"
        android:layout_marginTop="8dp">
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/dashboard_pink_tile">
            <ImageView
                android:layout_width="17dp"
                android:layout_height="17dp"
                android:src="@drawable/dashboard_coffee"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:layout_gravity="center" />
        </FrameLayout>
        <View
            android:layout_width="12dp"
            android:layout_height="1dp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_coffee"
                android:textSize="16sp"
                android:textColor="@color/finora_ink"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_coffee_details"
                android:textSize="11sp"
                android:textColor="@color/finora_secondary"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
        <View
            android:layout_width="8dp"
            android:layout_height="1dp" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_coffee_amount"
                android:textSize="17sp"
                android:textColor="@color/finora_expense"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_coffee_source"
                android:textSize="10sp"
                android:textColor="@color/finora_muted"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/dashboard_card"
        android:elevation="1dp"
        android:padding="12dp"
        android:layout_marginTop="8dp">
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/dashboard_blue_tile">
            <ImageView
                android:layout_width="22dp"
                android:layout_height="13dp"
                android:src="@drawable/dashboard_transport"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:layout_gravity="center" />
        </FrameLayout>
        <View
            android:layout_width="12dp"
            android:layout_height="1dp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_transport"
                android:textSize="16sp"
                android:textColor="@color/finora_ink"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_transport_details"
                android:textSize="11sp"
                android:textColor="@color/finora_secondary"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
        <View
            android:layout_width="8dp"
            android:layout_height="1dp" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_transport_amount"
                android:textSize="17sp"
                android:textColor="@color/finora_expense"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_transport_source"
                android:textSize="10sp"
                android:textColor="@color/finora_muted"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/dashboard_card"
        android:elevation="1dp"
        android:padding="12dp"
        android:layout_marginTop="8dp">
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/dashboard_mint_tile">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="15dp"
                android:src="@drawable/dashboard_salary"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:layout_gravity="center" />
        </FrameLayout>
        <View
            android:layout_width="12dp"
            android:layout_height="1dp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_salary"
                android:textSize="16sp"
                android:textColor="@color/finora_ink"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_salary_details"
                android:textSize="11sp"
                android:textColor="@color/finora_secondary"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
        <View
            android:layout_width="8dp"
            android:layout_height="1dp" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_salary_amount"
                android:textSize="17sp"
                android:textColor="@color/finora_emerald"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_salary_source"
                android:textSize="10sp"
                android:textColor="@color/finora_emerald"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/dashboard_card"
        android:elevation="1dp"
        android:padding="12dp"
        android:layout_marginTop="8dp">
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/dashboard_pink_tile">
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/dashboard_groceries"
                android:scaleType="fitCenter"
                android:importantForAccessibility="no"
                android:layout_gravity="center" />
        </FrameLayout>
        <View
            android:layout_width="12dp"
            android:layout_height="1dp" />
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_groceries"
                android:textSize="16sp"
                android:textColor="@color/finora_ink"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_groceries_details"
                android:textSize="11sp"
                android:textColor="@color/finora_secondary"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>
        <View
            android:layout_width="8dp"
            android:layout_height="1dp" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_groceries_amount"
                android:textSize="17sp"
                android:textColor="@color/finora_expense"
                android:includeFontPadding="false"
                android:fontFamily="sans-serif-medium" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_groceries_source"
                android:textSize="10sp"
                android:textColor="@color/finora_muted"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
