<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fillViewport="true">

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingBottom="24dp">

    <LinearLayout
      android:id="@+id/hero_container"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginTop="40dp"
      android:paddingHorizontal="16dp"
      android:paddingVertical="20dp"
      android:orientation="vertical"
      android:background="@drawable/onboarding_hero"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">

      <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="114dp"
        android:background="@drawable/cashflow_onboarding_wallet_bg"
        android:clipToOutline="true"
        tools:targetApi="s"
        android:elevation="3dp">
        <View
          android:layout_width="96dp"
          android:layout_height="96dp"
          android:layout_gravity="bottom|end"
          android:translationX="24dp"
          android:translationY="24dp"
          android:background="@drawable/cashflow_onboarding_wallet_glow" />
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:orientation="vertical"
          android:padding="16dp">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="18dp"
                tools:ignore="TextSizeCheck">

                <ImageView
                    android:id="@+id/cashflow_onboarding_wallet"
                    android:layout_width="14.25dp"
                    android:layout_height="13.5dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/cashflow_onboarding_wallet"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/cashflow_onboarding_assets"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/cashflow_onboarding_assets"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="@string/cashflow_onboarding_assets"
                    android:textColor="@color/finora_mint_bright"
                    android:textSize="11sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/cashflow_onboarding_growth"
                    app:layout_constraintStart_toEndOf="@id/cashflow_onboarding_wallet"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/cashflow_onboarding_growth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/cashflow_onboarding_growth_bg"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:text="@string/cashflow_onboarding_growth"
                    android:textColor="@color/finora_mint_pale"
                    android:textSize="11sp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/cashflow_onboarding_assets"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="4dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                tools:ignore="TextSizeCheck">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.025"
                    android:text="@string/cashflow_onboarding_balance"
                    android:textColor="@color/white"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif"
                    android:includeFontPadding="false"
                    android:text="@string/cashflow_onboarding_currency"
                    android:textColor="@color/white"
                    android:textSize="16sp" />
            </LinearLayout>
          <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp">
            <ImageView
              android:layout_width="11.667dp"
              android:layout_height="7dp"
              android:src="@drawable/cashflow_onboarding_income"
              android:importantForAccessibility="no"
              android:id="@+id/cashflow_onboarding_income"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintEnd_toStartOf="@id/cashflow_onboarding_income_2"
              app:layout_constraintTop_toTopOf="parent"
              app:layout_constraintBottom_toBottomOf="parent" />

              <TextView
                  android:id="@+id/cashflow_onboarding_income_2"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="4dp"
                  android:fontFamily="sans-serif"
                  android:includeFontPadding="false"
                  android:text="@string/cashflow_onboarding_income"
                  android:textColor="@color/finora_mint_medium"
                  android:textSize="11sp"
                  app:layout_constraintBottom_toBottomOf="parent"
                  app:layout_constraintEnd_toStartOf="@id/cashflow_onboarding_space_4"
                  app:layout_constraintStart_toEndOf="@id/cashflow_onboarding_income"
                  app:layout_constraintTop_toTopOf="parent"
                  tools:ignore="TextContrastCheck" />
            <Space
              android:layout_width="0dp"
              android:layout_height="1dp"
              android:id="@+id/cashflow_onboarding_space_4"
              app:layout_constraintStart_toEndOf="@id/cashflow_onboarding_income_2"
              app:layout_constraintEnd_toStartOf="@id/cashflow_onboarding_expense"
              app:layout_constraintTop_toTopOf="parent"
              app:layout_constraintBottom_toBottomOf="parent" />
            <ImageView
              android:layout_width="11.667dp"
              android:layout_height="7dp"
              android:src="@drawable/cashflow_onboarding_expense"
              android:importantForAccessibility="no"
              android:id="@+id/cashflow_onboarding_expense"
              app:layout_constraintStart_toEndOf="@id/cashflow_onboarding_space_4"
              app:layout_constraintEnd_toStartOf="@id/cashflow_onboarding_expense_2"
              app:layout_constraintTop_toTopOf="parent"
              app:layout_constraintBottom_toBottomOf="parent" />

              <TextView
                  android:id="@+id/cashflow_onboarding_expense_2"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="4dp"
                  android:fontFamily="sans-serif"
                  android:includeFontPadding="false"
                  android:text="@string/cashflow_onboarding_expense"
                  android:textColor="@color/finora_mint_medium"
                  android:textSize="11sp"
                  app:layout_constraintBottom_toBottomOf="parent"
                  app:layout_constraintEnd_toEndOf="parent"
                  app:layout_constraintStart_toEndOf="@id/cashflow_onboarding_expense"
                  app:layout_constraintTop_toTopOf="parent"
                  tools:ignore="TextContrastCheck" />
          </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
      </FrameLayout>

      <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp">

          <androidx.constraintlayout.widget.ConstraintLayout
              android:id="@+id/cashflow_onboarding_receipt_onboarding_metric"
              android:layout_width="0dp"
              android:layout_height="38dp"
              android:layout_marginEnd="2dp"
              android:background="@drawable/receipt_onboarding_metric"
              android:padding="4dp"
              app:layout_constraintEnd_toStartOf="@id/cashflow_onboarding_receipt_onboarding_metric_2"
              app:layout_constraintHorizontal_weight="1"
              app:layout_constraintStart_toStartOf="parent"
              app:layout_constraintTop_toTopOf="parent"
              tools:ignore="TextSizeCheck">

              <FrameLayout
                  android:id="@+id/cashflow_onboarding_dining_bg"
                  android:layout_width="28dp"
                  android:layout_height="28dp"
                  android:background="@drawable/cashflow_onboarding_dining_bg"
                  app:layout_constraintBottom_toBottomOf="parent"
                  app:layout_constraintEnd_toStartOf="@id/cashflow_onboarding_linear_layout_3"
                  app:layout_constraintStart_toStartOf="parent"
                  app:layout_constraintTop_toTopOf="parent">

                  <ImageView
                      android:layout_width="10dp"
                      android:layout_height="13.333dp"
                      android:layout_gravity="center"
                      android:importantForAccessibility="no"
                      android:src="@drawable/cashflow_onboarding_dining" />
              </FrameLayout>

              <LinearLayout
                  android:id="@+id/cashflow_onboarding_linear_layout_3"
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="8dp"
                  android:orientation="vertical"
                  app:layout_constraintBottom_toBottomOf="parent"
                  app:layout_constraintEnd_toEndOf="parent"
                  app:layout_constraintStart_toEndOf="@id/cashflow_onboarding_dining_bg"
                  app:layout_constraintTop_toTopOf="parent">

                  <TextView
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:ellipsize="end"
                      android:fontFamily="sans-serif"
                      android:includeFontPadding="false"
                      android:maxLines="1"
                      android:text="@string/cashflow_onboarding_dining"
                      android:textColor="@color/finora_ink"
                      android:textSize="11sp" />

                  <TextView
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_marginTop="2dp"
                      android:ellipsize="end"
                      android:fontFamily="sans-serif"
                      android:includeFontPadding="false"
                      android:maxLines="1"
                      android:text="@string/cashflow_onboarding_dining_limit"
                      android:textColor="@color/recovery_back_ink"
                      android:textSize="12sp" />
              </LinearLayout>
          </androidx.constraintlayout.widget.ConstraintLayout>

          <androidx.constraintlayout.widget.ConstraintLayout
              android:id="@+id/cashflow_onboarding_receipt_onboarding_metric_2"
              android:layout_width="0dp"
              android:layout_height="38dp"
              android:layout_marginStart="2dp"
              android:background="@drawable/receipt_onboarding_metric"
              android:padding="4dp"
              app:layout_constraintEnd_toEndOf="parent"
              app:layout_constraintHorizontal_weight="1"
              app:layout_constraintStart_toEndOf="@id/cashflow_onboarding_receipt_onboarding_metric"
              app:layout_constraintTop_toTopOf="parent"
              tools:ignore="TextSizeCheck">

              <FrameLayout
                  android:id="@+id/cashflow_onboarding_transport_bg"
                  android:layout_width="28dp"
                  android:layout_height="28dp"
                  android:background="@drawable/cashflow_onboarding_transport_bg"
                  app:layout_constraintBottom_toBottomOf="parent"
                  app:layout_constraintEnd_toStartOf="@id/cashflow_onboarding_linear_layout_2"
                  app:layout_constraintStart_toStartOf="parent"
                  app:layout_constraintTop_toTopOf="parent">

                  <ImageView
                      android:layout_width="12dp"
                      android:layout_height="10.667dp"
                      android:layout_gravity="center"
                      android:importantForAccessibility="no"
                      android:src="@drawable/cashflow_onboarding_transport" />
              </FrameLayout>

              <LinearLayout
                  android:id="@+id/cashflow_onboarding_linear_layout_2"
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_marginStart="8dp"
                  android:orientation="vertical"
                  app:layout_constraintBottom_toBottomOf="parent"
                  app:layout_constraintEnd_toEndOf="parent"
                  app:layout_constraintStart_toEndOf="@id/cashflow_onboarding_transport_bg"
                  app:layout_constraintTop_toTopOf="parent">

                  <TextView
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:ellipsize="end"
                      android:fontFamily="sans-serif"
                      android:includeFontPadding="false"
                      android:maxLines="1"
                      android:text="@string/cashflow_onboarding_transport"
                      android:textColor="@color/finora_ink"
                      android:textSize="11sp" />

                  <TextView
                      android:layout_width="match_parent"
                      android:layout_height="wrap_content"
                      android:layout_marginTop="2dp"
                      android:ellipsize="end"
                      android:fontFamily="sans-serif"
                      android:includeFontPadding="false"
                      android:maxLines="1"
                      android:text="@string/cashflow_onboarding_transport_amount"
                      android:textColor="@color/recovery_back_ink"
                      android:textSize="12sp" />
              </LinearLayout>
          </androidx.constraintlayout.widget.ConstraintLayout>
      </androidx.constraintlayout.widget.ConstraintLayout>

      <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:padding="8dp"
        android:background="@drawable/receipt_onboarding_metric">
        <FrameLayout
          android:layout_width="32dp"
          android:layout_height="32dp"
          android:background="@drawable/cashflow_onboarding_savings_bg"
          android:id="@+id/cashflow_onboarding_savings_bg"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintEnd_toStartOf="@id/cashflow_onboarding_linear_layout"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintBottom_toBottomOf="parent">
          <ImageView
            android:layout_width="15dp"
            android:layout_height="14.25dp"
            android:src="@drawable/cashflow_onboarding_savings"
            android:importantForAccessibility="no"
            android:layout_gravity="center" />
        </FrameLayout>
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:orientation="vertical"
          android:id="@+id/cashflow_onboarding_linear_layout"
          app:layout_constraintStart_toEndOf="@id/cashflow_onboarding_savings_bg"
          app:layout_constraintEnd_toStartOf="@id/cashflow_onboarding_constraint_layout"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintBottom_toBottomOf="parent">
          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cashflow_onboarding_savings"
            android:textSize="12sp"
            android:textColor="@color/finora_ink"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:textStyle="bold" />
          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cashflow_onboarding_savings_goal"
            android:textSize="12sp"
            android:textColor="@color/recovery_back_ink"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:layout_marginTop="2dp" />
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
          android:layout_width="64dp"
          android:layout_height="28dp"
          android:paddingHorizontal="4dp"
          android:importantForAccessibility="no"
          android:id="@+id/cashflow_onboarding_constraint_layout"
          app:layout_constraintStart_toEndOf="@id/cashflow_onboarding_linear_layout"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintBottom_toBottomOf="parent">
          <View
            android:layout_width="6dp"
            android:layout_height="12dp"
            android:background="@drawable/cashflow_onboarding_inactive"
            android:id="@+id/cashflow_onboarding_inactive"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/cashflow_onboarding_space"
            app:layout_constraintBottom_toBottomOf="parent" />
          <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:id="@+id/cashflow_onboarding_space"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/cashflow_onboarding_inactive"
            app:layout_constraintEnd_toStartOf="@id/cashflow_onboarding_bar_two"
            app:layout_constraintBottom_toBottomOf="parent" />
          <View
            android:layout_width="6dp"
            android:layout_height="16dp"
            android:background="@drawable/cashflow_onboarding_bar_two"
            android:id="@+id/cashflow_onboarding_bar_two"
            app:layout_constraintStart_toEndOf="@id/cashflow_onboarding_space"
            app:layout_constraintEnd_toStartOf="@id/cashflow_onboarding_space_2"
            app:layout_constraintBottom_toBottomOf="parent" />
          <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:id="@+id/cashflow_onboarding_space_2"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/cashflow_onboarding_bar_two"
            app:layout_constraintEnd_toStartOf="@id/cashflow_onboarding_bar_three"
            app:layout_constraintBottom_toBottomOf="parent" />
          <View
            android:layout_width="6dp"
            android:layout_height="24dp"
            android:background="@drawable/cashflow_onboarding_bar_three"
            android:id="@+id/cashflow_onboarding_bar_three"
            app:layout_constraintStart_toEndOf="@id/cashflow_onboarding_space_2"
            app:layout_constraintEnd_toStartOf="@id/cashflow_onboarding_space_3"
            app:layout_constraintBottom_toBottomOf="parent" />
          <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:id="@+id/cashflow_onboarding_space_3"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/cashflow_onboarding_bar_three"
            app:layout_constraintEnd_toStartOf="@id/cashflow_onboarding_onboarding_primary"
            app:layout_constraintBottom_toBottomOf="parent" />
          <View
            android:layout_width="6dp"
            android:layout_height="28dp"
            android:background="@drawable/onboarding_primary"
            android:id="@+id/cashflow_onboarding_onboarding_primary"
            app:layout_constraintStart_toEndOf="@id/cashflow_onboarding_space_3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
      </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <TextView
      android:id="@+id/cashflow_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:text="@string/cashflow_onboarding_title"
      android:textSize="24sp"
      android:textColor="@color/finora_ink"
      android:fontFamily="sans-serif"
      android:includeFontPadding="false"
      android:layout_marginTop="24dp"
      android:textStyle="bold"
      android:lineSpacingExtra="4dp"
      android:letterSpacing="-0.025"
      android:accessibilityHeading="true"
      tools:targetApi="p"
      app:layout_constraintTop_toBottomOf="@id/hero_container"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

    <TextView
      android:id="@+id/cashflow_description"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:text="@string/cashflow_onboarding_description"
      android:textSize="16sp"
      android:textColor="@color/finora_secondary"
      android:fontFamily="sans-serif"
      android:includeFontPadding="false"
      android:layout_marginTop="4dp"
      android:lineSpacingExtra="5dp"
      android:letterSpacing="0.01"
      app:layout_constraintTop_toBottomOf="@id/cashflow_title"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

    <!-- Feature 1 -->
    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/feature_1_container"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:minHeight="40dp"
      android:padding="8dp"
      android:background="@drawable/receipt_onboarding_feature"
      android:layout_marginTop="16dp"
      app:layout_constraintTop_toBottomOf="@id/cashflow_description"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">

      <FrameLayout
        android:id="@+id/feature_1_check_bg"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/onboarding_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
          android:layout_width="10.188dp"
          android:layout_height="7.516dp"
          android:src="@drawable/cashflow_onboarding_check"
          android:importantForAccessibility="no"
          android:layout_gravity="center" />
      </FrameLayout>

      <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/cashflow_onboarding_recognition"
        android:textSize="14sp"
        android:textColor="@color/finora_ink"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:layout_marginStart="8dp"
        android:textStyle="bold"
        android:lineSpacingExtra="3dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/feature_1_check_bg"
        app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Feature 2 -->
    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/feature_2_container"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:minHeight="40dp"
      android:padding="8dp"
      android:background="@drawable/receipt_onboarding_feature"
      android:layout_marginTop="8dp"
      app:layout_constraintTop_toBottomOf="@id/feature_1_container"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">

      <FrameLayout
        android:id="@+id/feature_2_check_bg"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/onboarding_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
          android:layout_width="10.188dp"
          android:layout_height="7.516dp"
          android:src="@drawable/cashflow_onboarding_check"
          android:importantForAccessibility="no"
          android:layout_gravity="center" />
      </FrameLayout>

      <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/cashflow_onboarding_budget_alert"
        android:textSize="14sp"
        android:textColor="@color/finora_ink"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:layout_marginStart="8dp"
        android:textStyle="bold"
        android:lineSpacingExtra="3dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/feature_2_check_bg"
        app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

  </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
