<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fillViewport="true">

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingBottom="24dp">

    <LinearLayout
      android:id="@+id/hero_container"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginTop="40dp"
      android:paddingHorizontal="16dp"
      android:paddingVertical="20dp"
      android:orientation="vertical"
      android:background="@drawable/onboarding_hero"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">

      <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="114dp"
        android:background="@drawable/cashflow_onboarding_wallet_bg"
        android:clipToOutline="true"
        tools:targetApi="s"
        android:elevation="3dp">
        <View
          android:layout_width="96dp"
          android:layout_height="96dp"
          android:layout_gravity="bottom|end"
          android:translationX="24dp"
          android:translationY="24dp"
          android:background="@drawable/cashflow_onboarding_wallet_glow" />
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:orientation="vertical"
          android:padding="16dp">
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:baselineAligned="false">
            <ImageView
              android:layout_width="14.25dp"
              android:layout_height="13.5dp"
              android:src="@drawable/cashflow_onboarding_wallet"
              android:importantForAccessibility="no" />
            <TextView
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:text="@string/cashflow_onboarding_assets"
              android:textSize="11sp"
              android:textColor="#95F4DE"
              android:fontFamily="sans-serif"
              android:includeFontPadding="false"
              android:layout_marginStart="6dp"
              android:layout_weight="1"
              android:maxLines="1"
              android:ellipsize="end" />
            <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/cashflow_onboarding_growth"
              android:textSize="11sp"
              android:textColor="#D4FFF3"
              android:fontFamily="sans-serif"
              android:includeFontPadding="false"
              android:background="@drawable/cashflow_onboarding_growth_bg"
              android:paddingHorizontal="8dp"
              android:paddingVertical="2dp" />
          </LinearLayout>
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">
            <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/cashflow_onboarding_balance"
              android:textSize="30sp"
              android:textColor="#FFFFFF"
              android:fontFamily="sans-serif"
              android:includeFontPadding="false"
              android:textStyle="bold"
              android:letterSpacing="-0.025" />
            <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/cashflow_onboarding_currency"
              android:textSize="16sp"
              android:textColor="#FFFFFF"
              android:fontFamily="sans-serif"
              android:includeFontPadding="false"
              android:layout_marginStart="6dp" />
          </LinearLayout>
          <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">
            <ImageView
              android:layout_width="11.667dp"
              android:layout_height="7dp"
              android:src="@drawable/cashflow_onboarding_income"
              android:importantForAccessibility="no" />
            <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/cashflow_onboarding_income"
              android:textSize="11sp"
              android:textColor="#78D7C2"
              android:fontFamily="sans-serif"
              android:includeFontPadding="false"
              android:layout_marginStart="4dp" />
            <Space
              android:layout_width="0dp"
              android:layout_height="1dp"
              android:layout_weight="1" />
            <ImageView
              android:layout_width="11.667dp"
              android:layout_height="7dp"
              android:src="@drawable/cashflow_onboarding_expense"
              android:importantForAccessibility="no" />
            <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/cashflow_onboarding_expense"
              android:textSize="11sp"
              android:textColor="#78D7C2"
              android:fontFamily="sans-serif"
              android:includeFontPadding="false"
              android:layout_marginStart="4dp" />
          </LinearLayout>
        </LinearLayout>
      </FrameLayout>

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:baselineAligned="false">
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="38dp"
          android:layout_weight="1"
          android:padding="4dp"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:background="@drawable/receipt_onboarding_metric"
          android:layout_marginEnd="2dp"
          android:baselineAligned="false">
          <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/cashflow_onboarding_dining_bg">
            <ImageView
              android:layout_width="10dp"
              android:layout_height="13.333dp"
              android:src="@drawable/cashflow_onboarding_dining"
              android:importantForAccessibility="no"
              android:layout_gravity="center" />
          </FrameLayout>
          <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">
            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="@string/cashflow_onboarding_dining"
              android:textSize="11sp"
              android:textColor="@color/onboarding_text"
              android:fontFamily="sans-serif"
              android:includeFontPadding="false"
              android:maxLines="1"
              android:ellipsize="end" />
            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="@string/cashflow_onboarding_dining_limit"
              android:textSize="12sp"
              android:textColor="#4D635C"
              android:fontFamily="sans-serif"
              android:includeFontPadding="false"
              android:layout_marginTop="2dp"
              android:maxLines="1"
              android:ellipsize="end" />
          </LinearLayout>
        </LinearLayout>
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="38dp"
          android:layout_weight="1"
          android:padding="4dp"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:background="@drawable/receipt_onboarding_metric"
          android:layout_marginStart="2dp"
          android:baselineAligned="false">
          <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/cashflow_onboarding_transport_bg">
            <ImageView
              android:layout_width="12dp"
              android:layout_height="10.667dp"
              android:src="@drawable/cashflow_onboarding_transport"
              android:importantForAccessibility="no"
              android:layout_gravity="center" />
          </FrameLayout>
          <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">
            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="@string/cashflow_onboarding_transport"
              android:textSize="11sp"
              android:textColor="@color/onboarding_text"
              android:fontFamily="sans-serif"
              android:includeFontPadding="false"
              android:maxLines="1"
              android:ellipsize="end" />
            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="@string/cashflow_onboarding_transport_amount"
              android:textSize="12sp"
              android:textColor="#4D635C"
              android:fontFamily="sans-serif"
              android:includeFontPadding="false"
              android:layout_marginTop="2dp"
              android:maxLines="1"
              android:ellipsize="end" />
          </LinearLayout>
        </LinearLayout>
      </LinearLayout>

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="@drawable/receipt_onboarding_metric"
        android:baselineAligned="false">
        <FrameLayout
          android:layout_width="32dp"
          android:layout_height="32dp"
          android:background="@drawable/cashflow_onboarding_savings_bg">
          <ImageView
            android:layout_width="15dp"
            android:layout_height="14.25dp"
            android:src="@drawable/cashflow_onboarding_savings"
            android:importantForAccessibility="no"
            android:layout_gravity="center" />
        </FrameLayout>
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:layout_marginStart="8dp"
          android:orientation="vertical">
          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cashflow_onboarding_savings"
            android:textSize="12sp"
            android:textColor="@color/onboarding_text"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:textStyle="bold" />
          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cashflow_onboarding_savings_goal"
            android:textSize="12sp"
            android:textColor="#4D635C"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:layout_marginTop="2dp" />
        </LinearLayout>
        <LinearLayout
          android:layout_width="64dp"
          android:layout_height="28dp"
          android:orientation="horizontal"
          android:gravity="bottom"
          android:paddingHorizontal="4dp"
          android:importantForAccessibility="no"
          android:baselineAligned="false">
          <View
            android:layout_width="6dp"
            android:layout_height="12dp"
            android:background="@drawable/cashflow_onboarding_inactive" />
          <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
          <View
            android:layout_width="6dp"
            android:layout_height="16dp"
            android:background="@drawable/cashflow_onboarding_bar_two" />
          <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
          <View
            android:layout_width="6dp"
            android:layout_height="24dp"
            android:background="@drawable/cashflow_onboarding_bar_three" />
          <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
          <View
            android:layout_width="6dp"
            android:layout_height="28dp"
            android:background="@drawable/onboarding_primary" />
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>

    <TextView
      android:id="@+id/cashflow_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:text="@string/cashflow_onboarding_title"
      android:textSize="24sp"
      android:textColor="@color/onboarding_text"
      android:fontFamily="sans-serif"
      android:includeFontPadding="false"
      android:layout_marginTop="24dp"
      android:textStyle="bold"
      android:lineSpacingExtra="4dp"
      android:letterSpacing="-0.025"
      android:accessibilityHeading="true"
      tools:targetApi="p"
      app:layout_constraintTop_toBottomOf="@id/hero_container"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

    <TextView
      android:id="@+id/cashflow_description"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:text="@string/cashflow_onboarding_description"
      android:textSize="16sp"
      android:textColor="@color/onboarding_secondary"
      android:fontFamily="sans-serif"
      android:includeFontPadding="false"
      android:layout_marginTop="4dp"
      android:lineSpacingExtra="5dp"
      android:letterSpacing="0.01"
      app:layout_constraintTop_toBottomOf="@id/cashflow_title"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

    <!-- Feature 1 -->
    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/feature_1_container"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:minHeight="40dp"
      android:padding="8dp"
      android:background="@drawable/receipt_onboarding_feature"
      android:layout_marginTop="16dp"
      app:layout_constraintTop_toBottomOf="@id/cashflow_description"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">

      <FrameLayout
        android:id="@+id/feature_1_check_bg"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/onboarding_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
          android:layout_width="10.188dp"
          android:layout_height="7.516dp"
          android:src="@drawable/cashflow_onboarding_check"
          android:importantForAccessibility="no"
          android:layout_gravity="center" />
      </FrameLayout>

      <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/cashflow_onboarding_recognition"
        android:textSize="14sp"
        android:textColor="@color/onboarding_text"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:layout_marginStart="8dp"
        android:textStyle="bold"
        android:lineSpacingExtra="3dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/feature_1_check_bg"
        app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Feature 2 -->
    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/feature_2_container"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:minHeight="40dp"
      android:padding="8dp"
      android:background="@drawable/receipt_onboarding_feature"
      android:layout_marginTop="8dp"
      app:layout_constraintTop_toBottomOf="@id/feature_1_container"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">

      <FrameLayout
        android:id="@+id/feature_2_check_bg"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/onboarding_primary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
          android:layout_width="10.188dp"
          android:layout_height="7.516dp"
          android:src="@drawable/cashflow_onboarding_check"
          android:importantForAccessibility="no"
          android:layout_gravity="center" />
      </FrameLayout>

      <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/cashflow_onboarding_budget_alert"
        android:textSize="14sp"
        android:textColor="@color/onboarding_text"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:layout_marginStart="8dp"
        android:textStyle="bold"
        android:lineSpacingExtra="3dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/feature_2_check_bg"
        app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

  </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
