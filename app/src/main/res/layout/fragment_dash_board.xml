<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_background">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="60dp">
        <include
            layout="@layout/dashboard_header" />
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:id="@+id/dashboard_scroll"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="48dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_greeting"
                            android:textSize="20sp"
                            android:textColor="@color/dashboard_ink"
                            android:includeFontPadding="false"
                            android:fontFamily="sans-serif-medium" />
                        <View
                            android:layout_width="1dp"
                            android:layout_height="3dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_daily_spending"
                            android:textSize="12sp"
                            android:textColor="@color/dashboard_secondary"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                    <View
                        android:layout_width="8dp"
                        android:layout_height="1dp" />
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/dashboard_mint_pill"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp">
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="10dp"
                            android:src="@drawable/dashboard_sync"
                            android:scaleType="fitCenter"
                            android:importantForAccessibility="no" />
                        <View
                            android:layout_width="4dp"
                            android:layout_height="1dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_sync"
                            android:textSize="11sp"
                            android:textColor="@color/dashboard_muted"
                            android:includeFontPadding="false"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </LinearLayout>
                <include
                    layout="@layout/dashboard_balance" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/dashboard_scan_card"
                    android:padding="14dp"
                    android:layout_marginTop="16dp"
                    android:id="@+id/dashboard_scan"
                    android:contentDescription="@string/dashboard_scan_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/dashboard_accent_tile">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="20dp"
                            android:src="@drawable/dashboard_scan"
                            android:scaleType="fitCenter"
                            android:importantForAccessibility="no"
                            android:layout_gravity="center" />
                    </FrameLayout>
                    <View
                        android:layout_width="12dp"
                        android:layout_height="1dp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_scan"
                                android:textSize="12sp"
                                android:textColor="@color/dashboard_ink"
                                android:includeFontPadding="false"
                                android:fontFamily="sans-serif-medium" />
                            <View
                                android:layout_width="4dp"
                                android:layout_height="1dp" />
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:background="@drawable/dashboard_accent_pill"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/dashboard_new"
                                    android:textSize="9sp"
                                    android:textColor="@color/dashboard_white"
                                    android:includeFontPadding="false"
                                    android:fontFamily="sans-serif-medium" />
                            </LinearLayout>
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_scan_description"
                            android:textSize="12sp"
                            android:textColor="@color/dashboard_secondary"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                    <View
                        android:layout_width="8dp"
                        android:layout_height="1dp" />
                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/dashboard_white_tile">
                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="15dp"
                            android:src="@drawable/dashboard_camera"
                            android:scaleType="fitCenter"
                            android:importantForAccessibility="no"
                            android:layout_gravity="center" />
                    </FrameLayout>
                </LinearLayout>
                <include
                    layout="@layout/dashboard_budget" />
                <include
                    layout="@layout/dashboard_breakdown" />
                <include
                    layout="@layout/dashboard_trend" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/dashboard_tip_card"
                    android:padding="14dp"
                    android:layout_marginTop="16dp">
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/dashboard_accent_tile">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="17dp"
                            android:src="@drawable/dashboard_tip"
                            android:scaleType="fitCenter"
                            android:importantForAccessibility="no"
                            android:layout_gravity="center" />
                    </FrameLayout>
                    <View
                        android:layout_width="12dp"
                        android:layout_height="1dp" />
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_weight="1">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_tip"
                            android:textSize="12sp"
                            android:textColor="@color/dashboard_ink"
                            android:includeFontPadding="false"
                            android:fontFamily="sans-serif-medium" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_tip_description"
                            android:textSize="12sp"
                            android:textColor="@color/dashboard_secondary"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                </LinearLayout>
                <include
                    layout="@layout/dashboard_recent" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <include
        layout="@layout/dashboard_navigation" />
</FrameLayout>
