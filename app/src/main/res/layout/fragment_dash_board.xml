<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/finora_background">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingBottom="60dp">
        <include
            layout="@layout/dashboard_header"
            android:id="@+id/dash_board_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />
        <androidx.core.widget.NestedScrollView
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:id="@+id/dashboard_scroll"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:scrollbars="none"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/dash_board_header"
            app:layout_constraintBottom_toBottomOf="parent">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="48dp">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:id="@+id/dash_board_linear_layout_3"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/dash_board_dashboard_mint_pill"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_greeting"
                            android:textSize="20sp"
                            android:textColor="@color/finora_ink"
                            android:includeFontPadding="false"
                            android:fontFamily="sans-serif-medium" />
                        <View
                            android:layout_width="1dp"
                            android:layout_height="3dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_daily_spending"
                            android:textSize="12sp"
                            android:textColor="@color/finora_secondary"
                            android:includeFontPadding="false" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/dashboard_mint_pill"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        android:layout_marginStart="8dp"
                        android:id="@+id/dash_board_dashboard_mint_pill"
                        app:layout_constraintStart_toEndOf="@id/dash_board_linear_layout_3"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">
                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="10dp"
                            android:src="@drawable/dashboard_sync"
                            android:scaleType="fitCenter"
                            android:importantForAccessibility="no" />
                        <View
                            android:layout_width="4dp"
                            android:layout_height="1dp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_sync"
                            android:textSize="11sp"
                            android:textColor="@color/finora_muted"
                            android:includeFontPadding="false"
                            android:fontFamily="sans-serif-medium" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <include
                    android:id="@+id/dashboard_balance"
                    layout="@layout/dashboard_balance" />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/dashboard_scan_card"
                    android:padding="14dp"
                    android:layout_marginTop="16dp"
                    android:id="@+id/dashboard_scan"
                    android:contentDescription="@string/dashboard_scan_action"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground">
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/dashboard_accent_tile"
                        android:id="@+id/dash_board_dashboard_accent_tile_2"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/dash_board_linear_layout_2"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="20dp"
                            android:src="@drawable/dashboard_scan"
                            android:scaleType="fitCenter"
                            android:importantForAccessibility="no"
                            android:layout_gravity="center" />
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp"
                        android:id="@+id/dash_board_linear_layout_2"
                        app:layout_constraintStart_toEndOf="@id/dash_board_dashboard_accent_tile_2"
                        app:layout_constraintEnd_toStartOf="@id/dash_board_dashboard_white_tile"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/dashboard_scan"
                                android:textSize="12sp"
                                android:textColor="@color/finora_ink"
                                android:includeFontPadding="false"
                                android:fontFamily="sans-serif-medium" />
                            <View
                                android:layout_width="4dp"
                                android:layout_height="1dp" />
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:background="@drawable/dashboard_accent_pill"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/dashboard_new"
                                    android:textSize="11sp"
                                    android:textColor="@color/white"
                                    android:includeFontPadding="false"
                                    android:fontFamily="sans-serif-medium" />
                            </LinearLayout>
                        </LinearLayout>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_scan_description"
                            android:textSize="12sp"
                            android:textColor="@color/finora_secondary"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                    <FrameLayout
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/dashboard_white_tile"
                        android:layout_marginStart="8dp"
                        android:id="@+id/dash_board_dashboard_white_tile"
                        app:layout_constraintStart_toEndOf="@id/dash_board_linear_layout_2"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">
                        <ImageView
                            android:layout_width="17dp"
                            android:layout_height="15dp"
                            android:src="@drawable/dashboard_camera"
                            android:scaleType="fitCenter"
                            android:importantForAccessibility="no"
                            android:layout_gravity="center" />
                    </FrameLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <include
                    android:id="@+id/dashboard_budget"
                    layout="@layout/dashboard_budget" />
                <include
                    android:id="@+id/dashboard_breakdown"
                    layout="@layout/dashboard_breakdown" />
                <include
                    android:id="@+id/dashboard_trend"
                    layout="@layout/dashboard_trend" />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/dashboard_tip_card"
                    android:padding="14dp"
                    android:layout_marginTop="16dp">
                    <FrameLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/dashboard_accent_tile"
                        android:id="@+id/dash_board_dashboard_accent_tile"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/dash_board_linear_layout"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="17dp"
                            android:src="@drawable/dashboard_tip"
                            android:scaleType="fitCenter"
                            android:importantForAccessibility="no"
                            android:layout_gravity="center" />
                    </FrameLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp"
                        android:id="@+id/dash_board_linear_layout"
                        app:layout_constraintStart_toEndOf="@id/dash_board_dashboard_accent_tile"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_tip"
                            android:textSize="12sp"
                            android:textColor="@color/finora_ink"
                            android:includeFontPadding="false"
                            android:fontFamily="sans-serif-medium" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboard_tip_description"
                            android:textSize="12sp"
                            android:textColor="@color/finora_secondary"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:ellipsize="end" />
                    </LinearLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <include
                    android:id="@+id/dashboard_recent"
                    layout="@layout/dashboard_recent" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <include
        android:id="@+id/dashboard_navigation"
        layout="@layout/dashboard_navigation" />
</FrameLayout>
