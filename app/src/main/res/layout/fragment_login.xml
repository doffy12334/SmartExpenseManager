<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@color/finora_background"
  android:theme="@style/ThemeOverlay.SmartExpenseManager.Login">
  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="0dp"
    android:layout_height="64dp"
    android:paddingHorizontal="16dp"
    android:id="@+id/login_header_2"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toTopOf="parent">
    <FrameLayout
      android:id="@+id/login_back"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:contentDescription="@string/onboarding_back"
      android:clickable="true"
      android:focusable="true"
      android:background="?attr/selectableItemBackgroundBorderless"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toStartOf="@id/login_brand_bg"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintBottom_toBottomOf="parent">
      <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/onboarding_back"
        android:importantForAccessibility="no"
        android:layout_gravity="center" />
    </FrameLayout>
    <FrameLayout
      android:layout_width="28dp"
      android:layout_height="28dp"
      android:background="@drawable/login_brand_bg"
      android:layout_marginStart="8dp"
      android:id="@+id/login_brand_bg"
      app:layout_constraintStart_toEndOf="@id/login_back"
      app:layout_constraintEnd_toStartOf="@id/login_brand"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintBottom_toBottomOf="parent">
      <ImageView
        android:layout_width="14.25dp"
        android:layout_height="13.5dp"
        android:src="@drawable/login_brand"
        android:importantForAccessibility="no"
        android:layout_gravity="center" />
    </FrameLayout>
    <TextView
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:text="@string/login_brand"
      android:textColor="@color/finora_ink"
      android:textSize="16sp"
      android:fontFamily="sans-serif"
      android:includeFontPadding="false"
      android:layout_marginStart="4dp"
      android:maxLines="1"
      android:ellipsize="end"
      android:id="@+id/login_brand"
      app:layout_constraintStart_toEndOf="@id/login_brand_bg"
      app:layout_constraintEnd_toStartOf="@id/login_header"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintBottom_toBottomOf="parent" />
    <TextView
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="@string/login_header"
      android:textColor="@color/finora_secondary"
      android:textSize="14sp"
      android:fontFamily="sans-serif"
      android:includeFontPadding="false"
      android:textStyle="bold"
      android:id="@+id/login_header"
      app:layout_constraintStart_toEndOf="@id/login_brand"
      app:layout_constraintEnd_toStartOf="@id/login_onboarding_primary"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintBottom_toBottomOf="parent" />
    <FrameLayout
      android:layout_width="32dp"
      android:layout_height="32dp"
      android:background="@drawable/onboarding_primary"
      android:layout_marginStart="8dp"
      android:id="@+id/login_onboarding_primary"
      app:layout_constraintStart_toEndOf="@id/login_header"
      app:layout_constraintEnd_toEndOf="parent"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintBottom_toBottomOf="parent">
      <ImageView
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/onboarding_account"
        android:importantForAccessibility="no"
        android:layout_gravity="center" />
    </FrameLayout>
  </androidx.constraintlayout.widget.ConstraintLayout>
  <androidx.core.widget.NestedScrollView
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:fillViewport="true"
    android:importantForAutofill="yes"
    android:id="@+id/login_scroll"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toBottomOf="@id/login_header_2"
    app:layout_constraintBottom_toBottomOf="parent">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingHorizontal="16dp"
      android:paddingBottom="32dp"
      android:focusableInTouchMode="true">
      <FrameLayout
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp">
        <FrameLayout
          android:layout_width="64dp"
          android:layout_height="64dp"
          android:background="@drawable/login_hero"
          android:elevation="3dp"
          android:layout_gravity="center">
          <ImageView
            android:layout_width="26.917dp"
            android:layout_height="25.5dp"
            android:src="@drawable/login_wallet"
            android:importantForAccessibility="no"
            android:layout_gravity="center" />
        </FrameLayout>
        <FrameLayout
          android:layout_width="24dp"
          android:layout_height="24dp"
          android:background="@drawable/login_mint"
          android:layout_gravity="bottom|end"
          android:elevation="4dp">
          <ImageView
            android:layout_width="11.25dp"
            android:layout_height="11.25dp"
            android:src="@drawable/login_receipt"
            android:importantForAccessibility="no"
            android:layout_gravity="center" />
        </FrameLayout>
      </FrameLayout>
      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="22dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="@drawable/login_badge">
        <ImageView
          android:layout_width="9.333dp"
          android:layout_height="12.25dp"
          android:src="@drawable/login_lock"
          android:importantForAccessibility="no" />
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/login_security_badge"
          android:textColor="@color/finora_muted"
          android:textSize="11sp"
          android:fontFamily="sans-serif"
          android:includeFontPadding="false"
          android:layout_marginStart="4dp" />
      </LinearLayout>
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/login_title"
        android:textColor="@color/finora_ink"
        android:textSize="24sp"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:layout_marginTop="4dp"
        android:textStyle="bold"
        android:gravity="center"
        android:letterSpacing="-0.025"
        android:accessibilityHeading="true"
          tools:targetApi="28" />
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/login_description"
        android:textColor="@color/finora_secondary"
        android:textSize="14sp"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:padding="16dp"
        android:orientation="vertical"
        android:background="@drawable/login_card">
        <TextView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/login_identifier_label"
          android:textColor="@color/finora_secondary"
          android:textSize="12sp"
          android:fontFamily="sans-serif"
          android:includeFontPadding="false"
          android:labelFor="@id/login_identifier"
          android:textStyle="bold" />
        <androidx.constraintlayout.widget.ConstraintLayout
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:layout_marginTop="4dp"
          android:paddingHorizontal="8dp"
          android:background="@drawable/login_input">
          <ImageView
            android:layout_width="22.333dp"
            android:layout_height="14.667dp"
            android:src="@drawable/login_email"
            android:importantForAccessibility="no"
            android:id="@+id/login_email"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/login_identifier"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
          <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/login_identifier"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@null"
            android:padding="0dp"
            android:hint="@string/login_identifier_hint"
            android:inputType="textEmailAddress"
            android:autofillHints="username"
            android:imeOptions="actionNext"
            android:singleLine="true"
            android:textColor="@color/finora_ink"
            android:textColorHint="@color/finora_hint"
            android:textSize="16sp"
            android:fontFamily="sans-serif"
            android:saveEnabled="false"
            app:layout_constraintStart_toEndOf="@id/login_email"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
          android:id="@+id/login_identifier_error"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:textColor="@color/finora_error"
          android:textSize="12sp"
          android:accessibilityLiveRegion="polite"
          android:visibility="gone" />
        <androidx.constraintlayout.widget.ConstraintLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:minHeight="24dp"
          android:layout_marginTop="16dp">
          <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/login_password_label"
            android:textColor="@color/finora_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:labelFor="@id/login_password"
            android:textStyle="bold"
            android:id="@+id/login_password_label"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/login_forgot"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
          <TextView
            android:id="@+id/login_forgot"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:gravity="center"
            android:text="@string/login_forgot_password"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/finora_emerald"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"
            app:layout_constraintStart_toEndOf="@id/login_password_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:layout_marginTop="4dp"
          android:paddingHorizontal="8dp"
          android:background="@drawable/login_input">
          <ImageView
            android:layout_width="18.667dp"
            android:layout_height="19.25dp"
            android:src="@drawable/login_password"
            android:importantForAccessibility="no"
            android:id="@+id/login_password_2"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/login_password"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
          <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/login_password"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@null"
            android:padding="0dp"
            android:hint="@string/login_password_hint"
            android:inputType="textPassword"
            android:autofillHints="password"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:saveEnabled="false"
            android:textColor="@color/finora_ink"
            android:textColorHint="@color/finora_hint"
            android:textSize="16sp"
            android:fontFamily="sans-serif"
            app:layout_constraintStart_toEndOf="@id/login_password_2"
            app:layout_constraintEnd_toStartOf="@id/login_password_toggle"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
          <FrameLayout
            android:id="@+id/login_password_toggle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/login_show_password"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:layout_constraintStart_toEndOf="@id/login_password"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageView
              android:layout_width="20.167dp"
              android:layout_height="18.15dp"
              android:src="@drawable/login_visibility"
              android:importantForAccessibility="no"
              android:layout_gravity="center" />
          </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <TextView
          android:id="@+id/login_password_error"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginTop="4dp"
          android:text="@string/login_password_required"
          android:textColor="@color/finora_error"
          android:textSize="12sp"
          android:accessibilityLiveRegion="polite"
          android:visibility="gone" />
        <androidx.constraintlayout.widget.ConstraintLayout
          android:layout_width="match_parent"
          android:layout_height="48dp"
          android:layout_marginTop="8dp">
          <androidx.appcompat.widget.AppCompatCheckBox
            android:id="@+id/login_remember"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:button="@null"
            app:buttonTint="@null"
            android:paddingStart="0dp"
            android:paddingEnd="0dp"
            android:drawablePadding="8dp"
            android:text="@string/login_remember"
            android:textColor="@color/finora_ink"
            android:textSize="14sp"
            android:checked="true"
            android:saveEnabled="false"
            app:buttonCompat="@null"
            android:drawableStart="@drawable/login_checkbox"
            android:gravity="center_vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/login_shield"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
          <ImageView
            android:layout_width="12dp"
            android:layout_height="15dp"
            android:src="@drawable/login_shield"
            android:importantForAccessibility="no"
            android:id="@+id/login_shield"
            app:layout_constraintStart_toEndOf="@id/login_remember"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.google.android.material.button.MaterialButton
          android:id="@+id/login_submit"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:insetTop="0dp"
          android:insetBottom="0dp"
          android:text="@string/login_submit"
          android:textColor="@color/white"
          android:textSize="16sp"
          android:textAllCaps="false"
          app:cornerRadius="12dp"
          app:backgroundTint="@color/finora_teal"
          app:icon="@drawable/login_submit"
          app:iconTint="@null"
          app:iconSize="16.5dp"
          app:iconPadding="8dp"
          app:iconGravity="textStart"
          android:layout_marginTop="4dp" />
        <TextView
          android:id="@+id/login_status"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/login_service_unavailable"
          android:textColor="@color/finora_error"
          android:textSize="12sp"
          android:layout_marginTop="8dp"
          android:accessibilityLiveRegion="polite"
          android:visibility="gone" />
        <LinearLayout
          android:id="@+id/login_biometric"
          android:layout_width="match_parent"
          android:layout_height="52dp"
          android:layout_marginTop="8dp"
          android:orientation="horizontal"
          android:gravity="center"
          android:background="@drawable/onboarding_secondary"
          android:clickable="true"
          android:focusable="true">
          <ImageView
            android:layout_width="18.049dp"
            android:layout_height="19.964dp"
            android:src="@drawable/login_biometric"
            android:importantForAccessibility="no" />
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_biometric"
            android:textColor="@color/finora_muted"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:layout_marginStart="8dp"
            android:textStyle="bold" />
        </LinearLayout>
      </LinearLayout>
      <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="16dp">
        <View
          android:layout_width="0dp"
          android:layout_height="1dp"
          android:background="@color/finora_divider"
          android:id="@+id/login_finora_divider"
          app:layout_constraintHorizontal_weight="1"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintEnd_toStartOf="@id/login_divider"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintBottom_toBottomOf="parent" />
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/login_divider"
          android:textColor="@color/finora_hint"
          android:textSize="11sp"
          android:fontFamily="sans-serif"
          android:includeFontPadding="false"
          android:letterSpacing="0.05"
          android:id="@+id/login_divider"
          app:layout_constraintStart_toEndOf="@id/login_finora_divider"
          app:layout_constraintEnd_toStartOf="@id/login_finora_divider_2"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintBottom_toBottomOf="parent"
          android:layout_marginStart="8dp"
          android:layout_marginEnd="8dp" />
        <View
          android:layout_width="0dp"
          android:layout_height="1dp"
          android:background="@color/finora_divider"
          android:id="@+id/login_finora_divider_2"
          app:layout_constraintHorizontal_weight="1"
          app:layout_constraintStart_toEndOf="@id/login_divider"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintBottom_toBottomOf="parent" />
      </androidx.constraintlayout.widget.ConstraintLayout>
      <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="50dp">
        <LinearLayout
          android:id="@+id/login_google"
          android:layout_width="0dp"
          android:layout_height="0dp"
          android:layout_marginEnd="4dp"
          android:orientation="horizontal"
          android:gravity="center"
          android:background="@drawable/login_input"
          android:clickable="true"
          android:focusable="true"
          app:layout_constraintHorizontal_weight="1"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintEnd_toStartOf="@id/login_apple"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintBottom_toBottomOf="parent">
          <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/login_google"
            android:importantForAccessibility="no" />
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_google"
            android:textColor="@color/finora_ink"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:layout_marginStart="8dp"
            android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
          android:id="@+id/login_apple"
          android:layout_width="0dp"
          android:layout_height="0dp"
          android:layout_marginStart="4dp"
          android:orientation="horizontal"
          android:gravity="center"
          android:background="@drawable/login_input"
          android:clickable="true"
          android:focusable="true"
          app:layout_constraintHorizontal_weight="1"
          app:layout_constraintStart_toEndOf="@id/login_google"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintBottom_toBottomOf="parent">
          <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/login_apple"
            android:importantForAccessibility="no" />
          <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/login_apple"
            android:textColor="@color/finora_ink"
            android:textSize="14sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:layout_marginStart="8dp"
            android:textStyle="bold" />
        </LinearLayout>
      </androidx.constraintlayout.widget.ConstraintLayout>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center">
        <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/login_signup_prompt"
          android:textColor="@color/finora_secondary"
          android:textSize="14sp"
          android:fontFamily="sans-serif"
          android:includeFontPadding="false" />
        <com.google.android.material.button.MaterialButton
          android:id="@+id/login_signup"
          style="@style/Widget.Material3.Button.TextButton"
          android:layout_width="wrap_content"
          android:layout_height="48dp"
          android:paddingHorizontal="4dp"
          android:insetLeft="0dp"
          android:insetRight="0dp"
          android:minWidth="0dp"
          android:text="@string/login_signup"
          android:textSize="14sp"
          android:textStyle="bold"
          android:textColor="@color/finora_emerald" />
      </LinearLayout>
      <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:padding="8dp"
        android:background="@drawable/login_input">
        <FrameLayout
          android:layout_width="32dp"
          android:layout_height="32dp"
          android:background="@drawable/login_badge"
          android:id="@+id/login_badge"
          app:layout_constraintStart_toStartOf="parent"
          app:layout_constraintEnd_toStartOf="@id/login_linear_layout"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintBottom_toBottomOf="parent">
          <ImageView
            android:layout_width="16.5dp"
            android:layout_height="15.75dp"
            android:src="@drawable/login_certificate"
            android:importantForAccessibility="no"
            android:layout_gravity="center" />
        </FrameLayout>
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:orientation="vertical"
          android:id="@+id/login_linear_layout"
          app:layout_constraintStart_toEndOf="@id/login_badge"
          app:layout_constraintEnd_toEndOf="parent"
          app:layout_constraintTop_toTopOf="parent"
          app:layout_constraintBottom_toBottomOf="parent">
          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_certificate_title"
            android:textColor="@color/finora_ink"
            android:textSize="11sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:textStyle="bold" />
          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/login_certificate_body"
            android:textColor="@color/finora_secondary"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:layout_marginTop="2dp"
            android:lineSpacingExtra="2dp" />
        </LinearLayout>
      </androidx.constraintlayout.widget.ConstraintLayout>
