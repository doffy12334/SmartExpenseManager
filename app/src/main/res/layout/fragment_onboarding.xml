<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@color/onboarding_background">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:paddingHorizontal="16dp"
    android:gravity="center_vertical">
    <FrameLayout
      android:id="@+id/onboarding_back"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:contentDescription="@string/onboarding_back"
      android:clickable="true"
      android:focusable="true">
      <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/onboarding_back"
        android:importantForAccessibility="no"
        android:layout_gravity="center" />
    </FrameLayout>
    <Space
      android:layout_width="0dp"
      android:layout_height="1dp"
      android:layout_weight="1" />
    <Button
      android:id="@+id/onboarding_skip"
      style="@style/Widget.Material3.Button.TextButton"
      android:layout_width="wrap_content"
      android:layout_height="48dp"
      android:minWidth="48dp"
      android:text="@string/onboarding_skip"
      android:textColor="#4D635C"
      android:textSize="14sp"
      android:paddingHorizontal="8dp"
        tools:ignore="VisualLintSystemUi" />
    <FrameLayout
      android:id="@+id/onboarding_account"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:contentDescription="@string/onboarding_account"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:clickable="true"
      android:focusable="true">
      <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:background="@drawable/onboarding_primary">
        <ImageView
          android:layout_width="12dp"
          android:layout_height="12dp"
          android:src="@drawable/onboarding_account"
          android:importantForAccessibility="no"
          android:layout_gravity="center" />
      </FrameLayout>
    </FrameLayout>
  </LinearLayout>
  <androidx.viewpager2.widget.ViewPager2
    android:id="@+id/onboarding_view_pager"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1" />
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingBottom="24dp">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="40dp"
      android:gravity="center"
      android:importantForAccessibility="yes"
      android:id="@+id/onboarding_indicators">
      <View
        android:id="@+id/indicator_dot_1"
        android:layout_width="28dp"
        android:layout_height="10dp"
        android:background="@drawable/onboarding_primary" />
      <View
        android:id="@+id/indicator_dot_2"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/onboarding_dot"
        android:layout_marginStart="8dp" />
      <View
        android:id="@+id/indicator_dot_3"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:background="@drawable/onboarding_dot"
        android:layout_marginStart="8dp" />
    </LinearLayout>
    <com.google.android.material.button.MaterialButton
      android:id="@+id/onboarding_start"
      android:layout_width="match_parent"
      android:layout_height="52dp"
      android:text="@string/onboarding_next"
      android:textSize="14sp"
      android:textStyle="bold"
      android:textColor="#FFFFFF"
      android:insetTop="0dp"
      android:insetBottom="0dp"
      app:cornerRadius="12dp"
      app:backgroundTint="@color/onboarding_primary"
      app:icon="@drawable/onboarding_next"
      app:iconSize="14dp"
      app:iconPadding="8dp"
      app:iconGravity="textEnd"
      app:iconTint="#FFFFFF"
        tools:ignore="VisualLintButtonSize" />
    <com.google.android.material.button.MaterialButton
      android:id="@+id/onboarding_login"
      android:layout_width="match_parent"
      android:layout_height="52dp"
      android:layout_marginTop="10dp"
      android:text="@string/onboarding_login"
      android:textColor="#0A1F1A"
      android:textSize="14sp"
      android:textStyle="bold"
      android:insetTop="0dp"
      android:insetBottom="0dp"
      app:cornerRadius="12dp"
      app:backgroundTint="#D0E8DF"
      app:elevation="0dp"
        tools:ignore="VisualLintButtonSize" />
    <TextView
      android:id="@+id/onboarding_legal"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="@string/onboarding_legal"
      android:textSize="12sp"
      android:textColor="@color/onboarding_secondary"
      android:fontFamily="sans-serif"
      android:includeFontPadding="false"
      android:layout_marginTop="16dp"
      android:paddingHorizontal="12dp"
      android:gravity="center"
      android:lineSpacingExtra="4dp"
      android:textColorLink="@color/onboarding_primary" />
  </LinearLayout>
</LinearLayout>