<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:orientation="vertical"
  android:background="@color/onboarding_background">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:paddingHorizontal="16dp"
    android:gravity="center_vertical">
    <FrameLayout
      android:id="@+id/onboarding_back"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:contentDescription="@string/onboarding_back"
      android:clickable="true"
      android:focusable="true">
      <ImageView
        android:layout_width="16dp"
        android:layout_height="16dp"
        android:src="@drawable/onboarding_back"
        android:importantForAccessibility="no"
        android:layout_gravity="center" />
    </FrameLayout>
    <Space
      android:layout_width="0dp"
      android:layout_height="1dp"
      android:layout_weight="1" />
    <Button
      android:id="@+id/onboarding_skip"
      style="@style/Widget.Material3.Button.TextButton"
      android:layout_width="wrap_content"
      android:layout_height="48dp"
      android:minWidth="48dp"
      android:text="@string/onboarding_skip"
      android:textColor="#4D635C"
      android:textSize="14sp"
      android:paddingHorizontal="8dp" />
    <FrameLayout
      android:id="@+id/onboarding_account"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:contentDescription="@string/onboarding_account"
      android:background="?attr/selectableItemBackgroundBorderless"
      android:clickable="true"
      android:focusable="true">
      <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:background="@drawable/onboarding_primary">
        <ImageView
          android:layout_width="12dp"
          android:layout_height="12dp"
          android:src="@drawable/onboarding_account"
          android:importantForAccessibility="no"
          android:layout_gravity="center" />
      </FrameLayout>
    </FrameLayout>
  </LinearLayout>
  <androidx.core.widget.NestedScrollView
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:fillViewport="true"
    android:clipToPadding="false">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingHorizontal="16dp"
      android:paddingBottom="24dp">
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="296dp"
        android:layout_marginTop="4dp"
        android:padding="24dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/onboarding_hero">
        <FrameLayout
          android:layout_width="280dp"
          android:layout_height="208dp"
          android:importantForAccessibility="noHideDescendants">
          <View
            android:layout_width="176dp"
            android:layout_height="176dp"
            android:background="@drawable/onboarding_ring"
            android:layout_gravity="center" />
          <View
            android:layout_width="128dp"
            android:layout_height="128dp"
            android:background="@drawable/onboarding_ring_inner"
            android:layout_gravity="center" />
          <LinearLayout
            android:layout_width="112dp"
            android:layout_height="112dp"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/onboarding_primary"
            android:elevation="6dp">
            <ImageView
              android:layout_width="29.333dp"
              android:layout_height="36.667dp"
              android:src="@drawable/onboarding_shield"
              android:importantForAccessibility="no" />
            <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="18dp"
              android:layout_marginTop="4dp"
              android:orientation="horizontal"
              android:gravity="center"
              android:paddingHorizontal="8dp"
              android:background="@drawable/onboarding_glass">
              <ImageView
                android:layout_width="8dp"
                android:layout_height="10.5dp"
                android:src="@drawable/onboarding_lock"
                android:importantForAccessibility="no" />
              <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_encryption"
                android:textSize="11sp"
                android:textColor="#FFFFFF"
                android:fontFamily="sans"
                android:includeFontPadding="false"
                android:layout_marginStart="4dp" />
            </LinearLayout>
          </LinearLayout>
          <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="32dp"
            android:background="@drawable/onboarding_verified_background"
            android:elevation="2dp">
            <ImageView
              android:layout_width="12dp"
              android:layout_height="15dp"
              android:src="@drawable/onboarding_verified"
              android:importantForAccessibility="no"
              android:layout_gravity="center" />
          </FrameLayout>
          <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="@drawable/onboarding_white"
            android:elevation="3dp"
            android:rotation="-3"
            android:layout_marginStart="11dp"
            android:layout_marginTop="4dp">
            <FrameLayout
              android:layout_width="32dp"
              android:layout_height="32dp"
              android:background="@drawable/onboarding_badge">
              <ImageView
                android:layout_width="15.041dp"
                android:layout_height="16.637dp"
                android:src="@drawable/onboarding_biometric"
                android:importantForAccessibility="no"
                android:layout_gravity="center" />
            </FrameLayout>
            <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:layout_marginStart="8dp">
              <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_biometric"
                android:textSize="11sp"
                android:textColor="@color/onboarding_text"
                android:fontFamily="sans"
                android:includeFontPadding="false" />
              <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_biometric_value"
                android:textSize="12sp"
                android:textColor="@color/onboarding_primary"
                android:fontFamily="sans"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp" />
            </LinearLayout>
          </LinearLayout>
          <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:background="@drawable/onboarding_white"
            android:elevation="3dp"
            android:rotation="2"
            android:layout_marginEnd="7dp"
            android:layout_marginBottom="5dp">
            <FrameLayout
              android:layout_width="32dp"
              android:layout_height="32dp"
              android:background="@drawable/onboarding_secondary">
              <ImageView
                android:layout_width="18.333dp"
                android:layout_height="13.333dp"
                android:src="@drawable/onboarding_cloud"
                android:importantForAccessibility="no"
                android:layout_gravity="center" />
            </FrameLayout>
            <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:layout_marginStart="8dp">
              <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_dual_backup"
                android:textSize="11sp"
                android:textColor="@color/onboarding_text"
                android:fontFamily="sans"
                android:includeFontPadding="false" />
              <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/onboarding_cloud_value"
                android:textSize="12sp"
                android:textColor="@color/onboarding_primary"
                android:fontFamily="sans"
                android:includeFontPadding="false"
                android:layout_marginTop="2dp" />
            </LinearLayout>
          </LinearLayout>
        </FrameLayout>
        <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="24dp"
          android:layout_marginTop="16dp"
          android:paddingHorizontal="12dp"
          android:orientation="horizontal"
          android:gravity="center"
          android:background="@drawable/onboarding_badge">
          <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/onboarding_primary" />
          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_bank_security"
            android:textSize="12sp"
            android:textColor="@color/onboarding_primary"
            android:fontFamily="sans"
            android:includeFontPadding="false"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />
        </LinearLayout>
      </LinearLayout>
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/onboarding_title"
        android:textSize="24sp"
        android:textColor="@color/onboarding_text"
        android:fontFamily="sans"
        android:includeFontPadding="false"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:textStyle="bold"
        android:letterSpacing="-0.025" />
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/onboarding_description"
        android:textSize="14sp"
        android:textColor="@color/onboarding_secondary"
        android:fontFamily="sans"
        android:includeFontPadding="false"
        android:layout_marginTop="4dp"
        android:paddingHorizontal="8dp"
        android:gravity="center"
        android:lineSpacingExtra="3dp"
        android:letterSpacing="0.015" />
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp">
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal"
          android:padding="8dp"
          android:layout_marginTop="10dp"
          android:background="@drawable/onboarding_surface">
          <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/onboarding_icon">
            <ImageView
              android:layout_width="13.333dp"
              android:layout_height="16.667dp"
              android:src="@drawable/onboarding_privacy"
              android:importantForAccessibility="no"
              android:layout_gravity="center" />
          </FrameLayout>
          <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="8dp">
            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="@string/onboarding_privacy_title"
              android:textSize="14sp"
              android:textColor="@color/onboarding_text"
              android:fontFamily="sans"
              android:includeFontPadding="false"
              android:textStyle="bold"
              android:lineSpacingExtra="3dp" />
            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="@string/onboarding_privacy_body"
              android:textSize="12sp"
              android:textColor="@color/onboarding_secondary"
              android:fontFamily="sans"
              android:includeFontPadding="false"
              android:lineSpacingExtra="2dp"
              android:letterSpacing="0.02" />
          </LinearLayout>
        </LinearLayout>
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:padding="8dp"
          android:layout_marginTop="10dp"
          android:background="@drawable/onboarding_surface">
          <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/onboarding_icon">
            <ImageView
              android:layout_width="16.667dp"
              android:layout_height="13.333dp"
              android:src="@drawable/onboarding_backup"
              android:importantForAccessibility="no"
              android:layout_gravity="center" />
          </FrameLayout>
          <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="8dp">
            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="@string/onboarding_backup_title"
              android:textSize="14sp"
              android:textColor="@color/onboarding_text"
              android:fontFamily="sans"
              android:includeFontPadding="false"
              android:textStyle="bold"
              android:lineSpacingExtra="3dp" />
            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="@string/onboarding_backup_body"
              android:textSize="12sp"
              android:textColor="@color/onboarding_secondary"
              android:fontFamily="sans"
              android:includeFontPadding="false"
              android:lineSpacingExtra="2dp"
              android:letterSpacing="0.02" />
          </LinearLayout>
        </LinearLayout>
      </LinearLayout>
      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center"
        android:contentDescription="@string/onboarding_progress"
        android:importantForAccessibility="yes">
        <View
          android:layout_width="10dp"
          android:layout_height="10dp"
          android:background="@drawable/onboarding_dot" />
        <View
          android:layout_width="10dp"
          android:layout_height="10dp"
          android:background="@drawable/onboarding_dot"
          android:layout_marginStart="8dp" />
        <View
          android:layout_width="28dp"
          android:layout_height="10dp"
          android:background="@drawable/onboarding_primary"
          android:layout_marginStart="8dp" />
      </LinearLayout>
      <com.google.android.material.button.MaterialButton
        android:id="@+id/onboarding_start"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/onboarding_start"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp"
        app:backgroundTint="@color/onboarding_primary" />
      <com.google.android.material.button.MaterialButton
        android:id="@+id/onboarding_login"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:text="@string/onboarding_login"
        android:textColor="#0A1F1A"
        android:textSize="14sp"
        android:textStyle="bold"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:cornerRadius="12dp"
        app:backgroundTint="#D0E8DF"
        app:elevation="0dp" />
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/onboarding_legal"
        android:textSize="12sp"
        android:textColor="@color/onboarding_secondary"
        android:fontFamily="sans"
        android:includeFontPadding="false"
        android:id="@+id/onboarding_legal"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="12dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:textColorLink="@color/onboarding_primary" />
    </LinearLayout>
  </androidx.core.widget.NestedScrollView>
</LinearLayout>

