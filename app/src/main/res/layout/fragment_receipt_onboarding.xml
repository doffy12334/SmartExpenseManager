<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fillViewport="true">

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingBottom="24dp">

    <LinearLayout
      android:id="@+id/hero_container"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="16dp"
      android:layout_marginTop="30dp"
      android:background="@drawable/receipt_onboarding_surface"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">

      <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="224dp"
        android:background="@drawable/receipt_onboarding_photo_background"
        android:clipToOutline="true"
        tools:targetApi="s"
        android:contentDescription="@string/receipt_onboarding_preview_description"
        android:importantForAccessibility="yes">
        <ImageView
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:src="@drawable/receipt_onboarding_photo"
          android:scaleType="centerCrop"
          android:alpha="0.85"
          android:importantForAccessibility="no" />
        <View
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:background="@drawable/receipt_onboarding_photo_shade" />
        <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="22dp"
          android:layout_gravity="top|start"
          android:layout_margin="12dp"
          android:gravity="center_vertical"
          android:orientation="horizontal"
          android:paddingHorizontal="10dp"
          android:background="@drawable/receipt_onboarding_ocr"
          android:baselineAligned="false">
          <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/onboarding_primary" />
          <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/receipt_onboarding_ocr"
            android:textColor="@color/onboarding_text"
            android:textSize="11sp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:layout_marginStart="6dp"
            android:letterSpacing="0.03" />
        </LinearLayout>
        <View
          android:layout_width="match_parent"
          android:layout_height="2dp"
          android:layout_gravity="center_vertical"
          android:background="@drawable/receipt_onboarding_scan_line" />
        <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_gravity="bottom"
          android:layout_margin="12dp"
          android:padding="10dp"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:background="@drawable/receipt_onboarding_preview"
          android:elevation="3dp"
          android:baselineAligned="false">
          <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/receipt_onboarding_dining_bg">
            <ImageView
              android:layout_width="11.25dp"
              android:layout_height="15dp"
              android:src="@drawable/receipt_onboarding_dining"
              android:importantForAccessibility="no"
              android:layout_gravity="center" />
          </FrameLayout>
          <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="4dp"
            android:orientation="vertical">
            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="@string/receipt_onboarding_merchant"
              android:textColor="@color/onboarding_text"
              android:textSize="12sp"
              android:fontFamily="sans-serif"
              android:includeFontPadding="false"
              android:textStyle="bold"
              android:maxLines="1"
              android:ellipsize="end" />
            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="@string/receipt_onboarding_category"
              android:textColor="@color/onboarding_secondary"
              android:textSize="12sp"
              android:fontFamily="sans-serif"
              android:includeFontPadding="false"
              android:layout_marginTop="2dp"
              android:maxLines="1"
              android:ellipsize="end" />
          </LinearLayout>
          <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">
            <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/receipt_onboarding_amount"
              android:textColor="@color/onboarding_primary"
              android:textSize="18sp"
              android:fontFamily="sans-serif"
              android:includeFontPadding="false"
              android:textStyle="bold"
              android:gravity="end"
              android:maxLines="1" />
            <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/receipt_onboarding_matched"
              android:textColor="@color/onboarding_primary"
              android:textSize="11sp"
              android:fontFamily="sans-serif"
              android:includeFontPadding="false"
              android:layout_marginTop="5dp"
              android:background="@drawable/receipt_onboarding_matched_bg"
              android:paddingHorizontal="6dp"
              android:paddingVertical="2dp"
              android:gravity="end" />
          </LinearLayout>
        </LinearLayout>
      </FrameLayout>

      <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:layout_marginTop="8dp">
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:padding="10dp"
          android:background="@drawable/receipt_onboarding_metric"
          android:layout_marginEnd="2dp"
          android:baselineAligned="false">
          <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/receipt_onboarding_trend_bg">
            <ImageView
              android:layout_width="14.667dp"
              android:layout_height="11.333dp"
              android:src="@drawable/receipt_onboarding_trend"
              android:importantForAccessibility="no"
              android:layout_gravity="center" />
          </FrameLayout>
          <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">
            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="@string/receipt_onboarding_week"
              android:textColor="@color/onboarding_secondary"
              android:textSize="11sp"
              android:fontFamily="sans-serif"
              android:includeFontPadding="false" />
            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="@string/receipt_onboarding_week_amount"
              android:textColor="@color/onboarding_text"
              android:textSize="12sp"
              android:fontFamily="sans-serif"
              android:includeFontPadding="false"
              android:textStyle="bold"
              android:layout_marginTop="2dp" />
          </LinearLayout>
        </LinearLayout>
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="horizontal"
          android:gravity="center_vertical"
          android:padding="10dp"
          android:background="@drawable/receipt_onboarding_metric"
          android:layout_marginStart="2dp"
          android:baselineAligned="false">
          <FrameLayout
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="@drawable/receipt_onboarding_speed_bg">
            <ImageView
              android:layout_width="10.667dp"
              android:layout_height="13.333dp"
              android:src="@drawable/receipt_onboarding_speed"
              android:importantForAccessibility="no"
              android:layout_gravity="center" />
          </FrameLayout>
          <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:orientation="vertical">
            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="@string/receipt_onboarding_speed"
              android:textColor="@color/onboarding_secondary"
              android:textSize="11sp"
              android:fontFamily="sans-serif"
              android:includeFontPadding="false" />
            <TextView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="@string/receipt_onboarding_speed_value"
              android:textColor="@color/onboarding_text"
              android:textSize="12sp"
              android:fontFamily="sans-serif"
              android:includeFontPadding="false"
              android:textStyle="bold"
              android:layout_marginTop="2dp" />
          </LinearLayout>
        </LinearLayout>
      </LinearLayout>
    </LinearLayout>

    <LinearLayout
      android:id="@+id/badge_container"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="24dp"
      android:paddingHorizontal="8dp"
      android:paddingVertical="2dp"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:background="@drawable/receipt_onboarding_badge"
      android:baselineAligned="false"
      app:layout_constraintTop_toBottomOf="@id/hero_container"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">
      <ImageView
        android:layout_width="14.667dp"
        android:layout_height="14.667dp"
        android:src="@drawable/receipt_onboarding_assistant"
        android:importantForAccessibility="no" />
      <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/receipt_onboarding_badge"
        android:textColor="@color/onboarding_primary"
        android:textSize="11sp"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:layout_marginStart="6dp"
        android:letterSpacing="0.05" />
    </LinearLayout>

    <TextView
      android:id="@+id/receipt_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:text="@string/receipt_onboarding_title"
      android:textColor="@color/onboarding_text"
      android:textSize="24sp"
      android:fontFamily="sans-serif"
      android:includeFontPadding="false"
      android:layout_marginTop="8dp"
      android:gravity="center"
      android:textStyle="bold"
      android:letterSpacing="-0.025"
      android:lineSpacingExtra="3dp"
      android:accessibilityHeading="true"
      tools:targetApi="p"
      app:layout_constraintTop_toBottomOf="@id/badge_container"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

    <TextView
      android:id="@+id/receipt_description"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:text="@string/receipt_onboarding_description"
      android:textColor="@color/onboarding_secondary"
      android:textSize="14sp"
      android:fontFamily="sans-serif"
      android:includeFontPadding="false"
      android:layout_marginTop="8dp"
      android:gravity="center"
      android:lineSpacingExtra="3dp"
      android:letterSpacing="0.015"
      app:layout_constraintTop_toBottomOf="@id/receipt_title"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

    <!-- Feature 1 -->
    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/feature_1_container"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:padding="12dp"
      android:background="@drawable/receipt_onboarding_feature"
      android:layout_marginTop="16dp"
      app:layout_constraintTop_toBottomOf="@id/receipt_description"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">

      <FrameLayout
        android:id="@+id/feature_1_icon_bg"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/receipt_onboarding_feature_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
          android:layout_width="15dp"
          android:layout_height="16.5dp"
          android:src="@drawable/receipt_onboarding_recognition"
          android:importantForAccessibility="no"
          android:layout_gravity="center" />
      </FrameLayout>

      <TextView
        android:id="@+id/feature_1_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/receipt_onboarding_recognition_title"
        android:textColor="@color/onboarding_text"
        android:textSize="14sp"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:textStyle="bold"
        android:lineSpacingExtra="3dp"
        android:layout_marginStart="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/feature_1_icon_bg"
        app:layout_constraintEnd_toEndOf="parent" />

      <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/receipt_onboarding_recognition_body"
        android:textColor="@color/onboarding_secondary"
        android:textSize="12sp"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:letterSpacing="0.02"
        app:layout_constraintTop_toBottomOf="@id/feature_1_title"
        app:layout_constraintStart_toStartOf="@id/feature_1_title"
        app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Feature 2 -->
    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/feature_2_container"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:padding="12dp"
      android:background="@drawable/receipt_onboarding_feature"
      android:layout_marginTop="8dp"
      app:layout_constraintTop_toBottomOf="@id/feature_1_container"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">

      <FrameLayout
        android:id="@+id/feature_2_icon_bg"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/receipt_onboarding_feature_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
          android:layout_width="15dp"
          android:layout_height="15dp"
          android:src="@drawable/receipt_onboarding_report"
          android:importantForAccessibility="no"
          android:layout_gravity="center" />
      </FrameLayout>

      <TextView
        android:id="@+id/feature_2_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/receipt_onboarding_report_title"
        android:textColor="@color/onboarding_text"
        android:textSize="14sp"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:textStyle="bold"
        android:lineSpacingExtra="3dp"
        android:layout_marginStart="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/feature_2_icon_bg"
        app:layout_constraintEnd_toEndOf="parent" />

      <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/receipt_onboarding_report_body"
        android:textColor="@color/onboarding_secondary"
        android:textSize="12sp"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:letterSpacing="0.02"
        app:layout_constraintTop_toBottomOf="@id/feature_2_title"
        app:layout_constraintStart_toStartOf="@id/feature_2_title"
        app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

  </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
