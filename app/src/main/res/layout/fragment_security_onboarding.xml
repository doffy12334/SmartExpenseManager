<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:fillViewport="true"
  android:clipToPadding="false">

  <androidx.constraintlayout.widget.ConstraintLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingBottom="16dp">

    <!-- Hero Card Container -->
    <LinearLayout
      android:id="@+id/hero_container"
      android:layout_width="0dp"
      android:layout_height="296dp"
      android:layout_marginTop="4dp"
      android:padding="24dp"
      android:orientation="vertical"
      android:gravity="center_horizontal"
      android:background="@drawable/onboarding_hero"
      app:layout_constraintTop_toTopOf="parent"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="280dp"
            android:layout_height="208dp"
            android:importantForAccessibility="noHideDescendants"
            tools:ignore="TextSizeCheck">

            <View
                android:layout_width="176dp"
                android:layout_height="176dp"
                android:layout_gravity="center"
                android:background="@drawable/onboarding_ring" />

            <View
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_gravity="center"
                android:background="@drawable/onboarding_ring_inner" />

            <LinearLayout
                android:layout_width="112dp"
                android:layout_height="112dp"
                android:layout_gravity="center"
                android:background="@drawable/onboarding_primary"
                android:elevation="6dp"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="29.333dp"
                    android:layout_height="36.667dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/onboarding_shield" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/onboarding_glass"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingHorizontal="8dp"
                    tools:ignore="TextSizeCheck">

                    <ImageView
                        android:layout_width="8dp"
                        android:layout_height="10.5dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/onboarding_lock" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/onboarding_encryption"
                        android:textColor="@color/white"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="32dp"
                android:background="@drawable/onboarding_verified_background"
                android:elevation="2dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="15dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/onboarding_verified" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_marginStart="11dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/onboarding_white"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:rotation="-3">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/onboarding_badge">

                    <ImageView
                        android:layout_width="15.041dp"
                        android:layout_height="16.637dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/onboarding_biometric" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/onboarding_biometric"
                        android:textColor="@color/finora_ink"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/onboarding_biometric_value"
                        android:textColor="@color/finora_emerald"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_marginEnd="7dp"
                android:layout_marginBottom="5dp"
                android:background="@drawable/onboarding_white"
                android:elevation="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:rotation="2">

                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/onboarding_secondary">

                    <ImageView
                        android:layout_width="18.333dp"
                        android:layout_height="13.333dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/onboarding_cloud" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/onboarding_dual_backup"
                        android:textColor="@color/finora_ink"
                        android:textSize="11sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:fontFamily="sans-serif"
                        android:includeFontPadding="false"
                        android:text="@string/onboarding_cloud_value"
                        android:textColor="@color/finora_emerald"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

      <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="12dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="@drawable/onboarding_badge">
        <View
          android:layout_width="8dp"
          android:layout_height="8dp"
          android:background="@drawable/onboarding_primary" />
        <TextView
          android:id="@+id/page_badge_text"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:text="@string/onboarding_bank_security"
          android:textSize="12sp"
          android:textColor="@color/finora_emerald"
          android:fontFamily="sans-serif"
          android:includeFontPadding="false"
          android:textStyle="bold"
          android:layout_marginStart="6dp" />
      </LinearLayout>
    </LinearLayout>

    <TextView
      android:id="@+id/page_title"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:text="@string/onboarding_title"
      android:textSize="24sp"
      android:textColor="@color/finora_ink"
      android:fontFamily="sans-serif"
      android:includeFontPadding="false"
      android:layout_marginTop="24dp"
      android:gravity="center"
      android:textStyle="bold"
      android:letterSpacing="-0.025"
      app:layout_constraintTop_toBottomOf="@id/hero_container"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

    <TextView
      android:id="@+id/page_description"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:text="@string/onboarding_description"
      android:textSize="14sp"
      android:textColor="@color/finora_secondary"
      android:fontFamily="sans-serif"
      android:includeFontPadding="false"
      android:layout_marginTop="4dp"
      android:paddingHorizontal="8dp"
      android:gravity="center"
      android:lineSpacingExtra="3dp"
      android:letterSpacing="0.015"
      app:layout_constraintTop_toBottomOf="@id/page_title"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent" />

    <!-- Feature 1 -->
    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/feature_1_container"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginTop="16dp"
      android:padding="8dp"
      android:background="@drawable/onboarding_surface"
      app:layout_constraintTop_toBottomOf="@id/page_description"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">

      <FrameLayout
        android:id="@+id/feature_1_icon_bg"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/onboarding_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
          android:id="@+id/page_feature1_icon"
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:src="@drawable/onboarding_privacy"
          android:importantForAccessibility="no"
          android:layout_gravity="center" />
      </FrameLayout>

      <TextView
        android:id="@+id/page_feature1_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/onboarding_privacy_title"
        android:textSize="14sp"
        android:textColor="@color/finora_ink"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:textStyle="bold"
        android:lineSpacingExtra="3dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/feature_1_icon_bg"
        app:layout_constraintEnd_toEndOf="parent" />

      <TextView
        android:id="@+id/page_feature1_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/onboarding_privacy_body"
        android:textSize="12sp"
        android:textColor="@color/finora_secondary"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:letterSpacing="0.02"
        app:layout_constraintTop_toBottomOf="@id/page_feature1_title"
        app:layout_constraintStart_toStartOf="@id/page_feature1_title"
        app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Feature 2 -->
    <androidx.constraintlayout.widget.ConstraintLayout
      android:id="@+id/feature_2_container"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:padding="8dp"
      android:background="@drawable/onboarding_surface"
      app:layout_constraintTop_toBottomOf="@id/feature_1_container"
      app:layout_constraintStart_toStartOf="parent"
      app:layout_constraintEnd_toEndOf="parent">

      <FrameLayout
        android:id="@+id/feature_2_icon_bg"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/onboarding_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">
        <ImageView
          android:id="@+id/page_feature2_icon"
          android:layout_width="16dp"
          android:layout_height="16dp"
          android:src="@drawable/onboarding_backup"
          android:importantForAccessibility="no"
          android:layout_gravity="center" />
      </FrameLayout>

      <TextView
        android:id="@+id/page_feature2_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/onboarding_backup_title"
        android:textSize="14sp"
        android:textColor="@color/finora_ink"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:textStyle="bold"
        android:lineSpacingExtra="3dp"
        android:layout_marginStart="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toEndOf="@id/feature_2_icon_bg"
        app:layout_constraintEnd_toEndOf="parent" />

      <TextView
        android:id="@+id/page_feature2_body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/onboarding_backup_body"
        android:textSize="12sp"
        android:textColor="@color/finora_secondary"
        android:fontFamily="sans-serif"
        android:includeFontPadding="false"
        android:lineSpacingExtra="2dp"
        android:letterSpacing="0.02"
        app:layout_constraintTop_toBottomOf="@id/page_feature2_title"
        app:layout_constraintStart_toStartOf="@id/page_feature2_title"
        app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

  </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
